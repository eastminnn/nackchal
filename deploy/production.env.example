# 운영 서버 ~/nackchal/.env의 항목. 실제 값은 서버에서만 만들고 레포에 올리지 않는다.
# 로컬 개발용 값은 루트 .env.example을 쓴다.
POSTGRES_DB=nackchal
POSTGRES_USER=nackchal
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32. 바꾸면 모든 사용자가 다시 로그인해야 한다.
JWT_SECRET=
# HTTPS에서만 인증 쿠키를 보낸다.
AUTH_COOKIE_SECURE=true
# WebSocket을 허용할 브라우저 출처. 운영 주소만 둔다.
ROOM_ALLOWED_ORIGINS=https://nackchal.duckdns.org
# Caddy가 인증서를 받을 도메인.
SITE_DOMAIN=nackchal.duckdns.org
