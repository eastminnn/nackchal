{
  "name": "nackchal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "doctor": "react-doctor . --verbose",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "qa:lobby": "node scripts/qa/lobby-qa.mjs",
    "qa:auth": "node scripts/qa/auth-qa.mjs",
    "qa:brand": "node scripts/qa/brand-qa.mjs",
    "qa:game": "node scripts/qa/desktop-qa.mjs",
    "qa:chat": "node scripts/qa/chat-qa.mjs",
    "qa:paddles": "vitest run src/scene/modelPose.test.ts -t 'plush bidding poses'",
    "qa:pranks": "vitest run src/scene/modelPose.test.ts -t 'prank reactions'",
    "qa:models": "node scripts/qa/model-failure-qa.mjs",
    "qa:animals": "node scripts/qa/animal-room-qa.mjs",
    "qa:performance": "node scripts/qa/performance-qa.mjs",
    "assets:prepare": "node scripts/assets/prepare-animal-room.mjs",
    "assets:portraits": "node scripts/assets/render-lobby-models.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/dynapuff": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/fiber": "^9.8.1",
    "ky": "^2.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lighthouse": "^13.5.0",
    "react-doctor": "^0.9.14",
    "react-grab": "^0.2.0",
    "react-scan": "^0.5.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
